# Copiar este archivo a ".env" y completar antes de correr el servidor.

# Puerto del servidor
PORT=3000

# Secreto usado para firmar la cookie de sesión del admin.
# Generar uno propio y largo, por ejemplo con: openssl rand -hex 32
SESSION_SECRET=cambiar-este-valor-por-uno-propio-y-largo

# Credenciales del panel de administración.
# El password se guarda hasheado en la base de datos en el primer arranque,
# tomando este valor solo la primera vez que se crea el usuario admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-esta-contraseña
